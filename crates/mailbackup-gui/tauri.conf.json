{
  "build": {
    "distDir": "../mailbackup-server/static",
    "devPath": "http://127.0.0.1:8765"
  },
  "package": {
    "productName": "MailBackup Studio",
    "version": "0.1.2"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "category": "Productivity",
      "copyright": "2026",
      "identifier": "com.mailbackup.studio",
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.ico",
        "icons/icon.icns",
        "icons/icon.png"
      ]
    },
    "security": {
      "csp": null
    },
    "systemTray": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 840,
        "resizable": true,
        "title": "MailBackup Studio",
        "width": 1280,
        "url": "http://127.0.0.1:8765"
      }
    ]
  }
}
