    {
      "name": "account_transitions",
      "sql": "CREATE TABLE account_transitions (\n                id INTEGER PRIMARY KEY AUTOINCREMENT,\n                live_id TEXT NOT NULL,\n                archive_id TEXT NOT NULL,\n                seq INTEGER NOT NULL,\n                old_credential_ref TEXT NOT NULL,\n                staged_credential_ref TEXT NOT NULL,\n                state TEXT NOT NULL,\n                created_at TEXT NOT NULL\n            )",
      "tbl_name": "account_transitions",
      "type": "table"
    },
    {
      "name": "accounts",
      "sql": "CREATE TABLE accounts (\n                id TEXT PRIMARY KEY,\n                name TEXT NOT NULL,\n                email TEXT NOT NULL UNIQUE,\n                provider TEXT NOT NULL,\n                created_at TEXT NOT NULL,\n                updated_at TEXT NOT NULL\n            )",
      "tbl_name": "accounts",
      "type": "table"
    },
    {
      "name": "attachments",
      "sql": "CREATE TABLE attachments (\n                id TEXT PRIMARY KEY,\n                message_id TEXT NOT NULL,\n                filename TEXT NOT NULL,\n                mime_type TEXT NOT NULL,\n                size_bytes INTEGER NOT NULL,\n                FOREIGN KEY(message_id) REFERENCES messages(id) ON DELETE CASCADE\n            )",
      "tbl_name": "attachments",
      "type": "table"
    },
    {
      "name": "folders",
      "sql": "CREATE TABLE folders (\n                id TEXT PRIMARY KEY,\n                account_id TEXT NOT NULL,\n                remote_name TEXT NOT NULL,\n                local_slug TEXT NOT NULL,\n                uidvalidity INTEGER,\n                last_synced_uid INTEGER NOT NULL DEFAULT 0,\n                message_count INTEGER NOT NULL DEFAULT 0,\n                updated_at TEXT NOT NULL,\n                remote_identity TEXT,\n                uid_generation INTEGER NOT NULL DEFAULT 0,\n                UNIQUE(account_id, remote_name)\n            )",
      "tbl_name": "folders",
      "type": "table"
    },
    {
      "name": "messages",
      "sql": "CREATE TABLE messages (\n                id TEXT PRIMARY KEY,\n                account_id TEXT NOT NULL,\n                folder_id TEXT NOT NULL,\n                uid INTEGER NOT NULL,\n                message_id TEXT,\n                subject TEXT,\n                from_addr TEXT,\n                to_addrs TEXT,\n                cc_addrs TEXT,\n                date TEXT,\n                size_bytes INTEGER NOT NULL,\n                relative_path TEXT NOT NULL,\n                sha256_hash TEXT NOT NULL,\n                is_remote_deleted INTEGER NOT NULL DEFAULT 0,\n                created_at TEXT NOT NULL,\n                uid_generation INTEGER NOT NULL, server_id_kind TEXT, server_id TEXT, server_id_source TEXT,\n                FOREIGN KEY(folder_id) REFERENCES folders(id) ON DELETE CASCADE,\n                UNIQUE(folder_id, uid_generation, uid)\n            )",
      "tbl_name": "messages",
      "type": "table"
    },
    {
      "name": "messages_fts",
      "sql": "CREATE VIRTUAL TABLE messages_fts USING fts5(\n                message_id UNINDEXED,\n                account_id UNINDEXED,\n                subject,\n                from_addr,\n                to_addrs,\n                body_text,\n                attachment_names,\n                tokenize = 'porter unicode61'\n            )",
      "tbl_name": "messages_fts",
      "type": "table"
    },
    {
      "name": "messages_fts_config",
      "sql": "CREATE TABLE 'messages_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID",
      "tbl_name": "messages_fts_config",
      "type": "table"
    },
    {
      "name": "messages_fts_content",
      "sql": "CREATE TABLE 'messages_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2, c3, c4, c5, c6)",
      "tbl_name": "messages_fts_content",
      "type": "table"
    },
    {
      "name": "messages_fts_data",
      "sql": "CREATE TABLE 'messages_fts_data'(id INTEGER PRIMARY KEY, block BLOB)",
      "tbl_name": "messages_fts_data",
      "type": "table"
    },
    {
      "name": "messages_fts_docsize",
      "sql": "CREATE TABLE 'messages_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)",
      "tbl_name": "messages_fts_docsize",
      "type": "table"
    },
    {
      "name": "messages_fts_idx",
      "sql": "CREATE TABLE 'messages_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID",
      "tbl_name": "messages_fts_idx",
      "type": "table"
    },
    {
      "name": "server_id_disabled",
      "sql": "CREATE TABLE server_id_disabled (\n                account_id TEXT NOT NULL,\n                source TEXT NOT NULL,\n                kind TEXT NOT NULL,\n                reason TEXT NOT NULL,\n                detected_at TEXT NOT NULL,\n                PRIMARY KEY(account_id, source, kind)\n            )",
      "tbl_name": "server_id_disabled",
      "type": "table"
    },
    {
      "name": "server_id_distrust",
      "sql": "CREATE TABLE server_id_distrust (\n                account_id TEXT NOT NULL,\n                source TEXT NOT NULL,\n                kind TEXT NOT NULL,\n                reason TEXT NOT NULL,\n                detected_at TEXT NOT NULL,\n                PRIMARY KEY(account_id, source, kind)\n            )",
      "tbl_name": "server_id_distrust",
      "type": "table"
    },
    {
      "name": "server_id_rebinds",
      "sql": "CREATE TABLE server_id_rebinds (\n                message_id TEXT PRIMARY KEY,\n                account_id TEXT NOT NULL,\n                folder_id TEXT NOT NULL,\n                source TEXT NOT NULL,\n                kind TEXT NOT NULL,\n                prev_generation INTEGER NOT NULL,\n                prev_uid INTEGER NOT NULL,\n                verified INTEGER NOT NULL DEFAULT 0,\n                needs_check INTEGER NOT NULL DEFAULT 0,\n                FOREIGN KEY(message_id) REFERENCES messages(id) ON DELETE CASCADE\n            )",
      "tbl_name": "server_id_rebinds",
      "type": "table"
    },
    {
      "name": "sqlite_sequence",
      "sql": "CREATE TABLE sqlite_sequence(name,seq)",
      "tbl_name": "sqlite_sequence",
      "type": "table"
    },
    {
      "name": "sync_history",
      "sql": "CREATE TABLE sync_history (\n                id TEXT PRIMARY KEY,\n                account_id TEXT NOT NULL,\n                status TEXT NOT NULL,\n                start_time TEXT NOT NULL,\n                end_time TEXT,\n                messages_downloaded INTEGER NOT NULL DEFAULT 0,\n                bytes_downloaded INTEGER NOT NULL DEFAULT 0,\n                error_message TEXT\n            )",
      "tbl_name": "sync_history",
      "type": "table"
    }
  ],
